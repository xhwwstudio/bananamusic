# Copy to .env and adjust. docker compose reads .env automatically.

# SQLite (default)
DATABASE_URL=sqlite:///./data/musicon.db
# PostgreSQL
# DATABASE_URL=postgresql+psycopg://musicon:change_me@postgres:5432/musicon

TZ=Asia/Shanghai

# Host bind address for port 8000. Use 127.0.0.1 behind Nginx/BaoTa reverse proxy.
MUSICON_BIND=0.0.0.0

# Initial admin / Subsonic account (change after first login in the web UI)
SUBSONIC_USER=admin
SUBSONIC_PASS=changeme

# LX Music Server: embedded (needs /app/vendor/lxserver) or remote
LX_SERVICE_MODE=embedded
LX_EMBEDDED_ENABLED=false
LX_EMBEDDED_HOST=127.0.0.1
LX_EMBEDDED_PORT=9527
# LX_REMOTE_URL=http://192.168.1.10:9527
